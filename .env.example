# World Feed Monitor: create a free account at https://worldfeedmonitor.com/register,
# then Dashboard -> API Credentials -> New. The secret is shown once.
WFM_API_KEY=your-api-key
WFM_API_SECRET=your-api-secret

# Anthropic: https://console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional overrides.
# WFM_MCP_URL=https://api.worldfeedmonitor.com/mcp
# ANTHROPIC_MODEL=claude-opus-5-5
